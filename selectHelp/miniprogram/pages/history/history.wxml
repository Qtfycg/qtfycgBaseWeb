<!-- pages/history/history.wxml — 历史记录（Story 20） -->
<view class="page">
  <!-- 筛选 -->
  <view class="filters">
    <view class="filter-group">
      <button
        class="ui-action filter-chip {{filterType === '' ? 'filter-active' : ''}}"
        aria-label="全部类型，{{filterType === '' ? '已选中' : '未选中'}}"
        hover-class="interactive-pressed"
        data-value=""
        bindtap="onFilterType"
      >全部</button>
      <button
        class="ui-action filter-chip {{filterType === 'cook' ? 'filter-active' : ''}}"
        aria-label="自做，{{filterType === 'cook' ? '已选中' : '未选中'}}"
        hover-class="interactive-pressed"
        data-value="cook"
        bindtap="onFilterType"
      >自做</button>
      <button
        class="ui-action filter-chip {{filterType === 'delivery' ? 'filter-active' : ''}}"
        aria-label="外卖，{{filterType === 'delivery' ? '已选中' : '未选中'}}"
        hover-class="interactive-pressed"
        data-value="delivery"
        bindtap="onFilterType"
      >外卖</button>
    </view>
    <view class="filter-group">
      <button
        class="ui-action filter-chip {{filterRange === 'week' ? 'filter-active' : ''}}"
        aria-label="本周，{{filterRange === 'week' ? '已选中' : '未选中'}}"
        hover-class="interactive-pressed"
        data-value="week"
        bindtap="onFilterRange"
      >本周</button>
      <button
        class="ui-action filter-chip {{filterRange === 'month' ? 'filter-active' : ''}}"
        aria-label="本月，{{filterRange === 'month' ? '已选中' : '未选中'}}"
        hover-class="interactive-pressed"
        data-value="month"
        bindtap="onFilterRange"
      >本月</button>
      <button
        class="ui-action filter-chip {{filterRange === 'all' ? 'filter-active' : ''}}"
        aria-label="全部时间，{{filterRange === 'all' ? '已选中' : '未选中'}}"
        hover-class="interactive-pressed"
        data-value="all"
        bindtap="onFilterRange"
      >全部</button>
    </view>
  </view>

  <!-- 列表 -->
  <view wx:if="{{items.length === 0}}" class="empty status-live" aria-live="polite">暂无用餐记录</view>
  <view
    wx:for="{{items}}"
    wx:key="id"
    class="history-item"
    data-type="{{item.type}}"
    data-id="{{item.candidateId}}"
    aria-role="button"
    aria-label="查看{{item.candidateName}}，{{item.typeLabel}}，{{item.timeText}}，{{item.ratingLabel}}"
    hover-class="interactive-pressed"
    bindtap="onItemTap"
  >
    <view class="item-main">
      <text class="tag {{item.type === 'cook' ? 'tag-success' : 'tag-info'}}">{{item.typeLabel}}</text>
      <text class="item-name">{{item.candidateName}}</text>
    </view>
    <view class="item-sub">
      <text>{{item.timeText}}</text>
      <text wx:if="{{item.estimatedCost != null}}" class="cost">约 ¥{{item.estimatedCost}}</text>
      <text class="rating {{item.ratingStatus === 'pending' ? 'rating-pending' : ''}}">{{item.ratingLabel}}</text>
    </view>
  </view>
</view>
