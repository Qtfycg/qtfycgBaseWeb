<!-- pages/index/index.wxml — "吃什么"推荐首页（Story 13）+ 条件面板（Story 14）+ 评价入口（Story 21） -->
<view class="page">
  <!-- 顶部问候区 -->
  <view class="header">
    <view class="header-title">{{greeting}}</view>
    <view class="header-sub">{{periodLabel}} · 帮你决定这一餐</view>
  </view>

  <!-- 定位降级提示（Story 22） -->
  <view wx:if="{{locationBanner}}" class="banner" aria-role="button" aria-label="{{locationBanner}}，点击查看定位设置" hover-class="interactive-pressed" bindtap="onLocationBannerTap">
    <text class="banner-icon">📍</text>
    <text class="banner-text">{{locationBanner}}</text>
    <text class="banner-arrow">›</text>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-area status-live" aria-live="polite" aria-label="正在生成推荐">
    <view class="skeleton-card" wx:for="{{[1, 2, 3]}}" wx:key="*this">
      <view class="skeleton-line skeleton-line-short"></view>
      <view class="skeleton-line skeleton-line-mid"></view>
      <view class="skeleton-line skeleton-line-long"></view>
    </view>
  </view>

  <!-- 空/错误状态 -->
  <view wx:elif="{{candidates.length === 0}}" class="empty-state status-live" aria-live="polite">
    <view class="empty-icon">🍽️</view>
    <text class="empty-title">暂无推荐</text>
    <text wx:if="{{shortfallReason}}" class="empty-detail">{{shortfallReason}}</text>
    <button class="btn-primary empty-btn" bindtap="onShortfallTap">调整条件再试</button>
  </view>

  <!-- 候选列表 -->
  <view wx:else>
    <view class="shortfall" wx:if="{{shortfallReason}}" aria-role="button" aria-label="{{shortfallReason}}，点击调整条件" hover-class="interactive-pressed" bindtap="onShortfallTap">
      <text class="shortfall-text">{{shortfallReason}}</text>
      <text class="shortfall-link">调整条件 ›</text>
    </view>
    <view class="diversity" wx:if="{{diversityNote}}">{{diversityNote}}</view>

    <view
      wx:for="{{candidates}}"
      wx:key="id"
      class="candidate-card"
      data-type="{{item.type}}"
      data-id="{{item.id}}"
      aria-role="button"
      aria-label="查看{{item.name}}，{{item.typeLabel}}，{{item.costText}}，{{item.timeText}}"
      hover-class="interactive-pressed"
      bindtap="onCandidateTap"
    >
      <view class="candidate-top">
        <view class="badge {{item.type === 'cook' ? 'badge-cook' : 'badge-delivery'}}">
          <text>{{item.type === 'cook' ? '🍳' : '🛵'}}</text>
          <text>{{item.typeLabel}}</text>
        </view>
        <text class="candidate-name">{{item.name}}</text>
      </view>
      <view class="candidate-meta">
        <text wx:if="{{item.costText}}" class="meta-item">{{item.costText}}</text>
        <text wx:if="{{item.timeText}}" class="meta-item">{{item.timeText}}</text>
      </view>
      <view class="candidate-reasons">
        <view wx:for="{{item.reasons}}" wx:key="*this" class="reason">
          <text class="reason-icon">✓</text>
          <text class="reason-text">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-bar">
      <button class="btn-primary action-refresh" bindtap="onRefresh">换一批</button>
      <button class="btn-ghost action-filter" bindtap="openPanel">调整条件</button>
    </view>
  </view>

  <!-- 评价弹层（Story 21） -->
  <view wx:if="{{ratingPrompt}}" class="panel-mask">
    <view class="panel rating-panel" catchtap="noop">
      <view class="panel-title">这餐「{{ratingPrompt.candidateName}}」怎么样？</view>
      <view class="rating-row">
        <button class="ui-action rating-option" aria-label="喜欢" hover-class="interactive-pressed" data-rating="like" bindtap="onRatingTap">
          <text class="rating-icon">👍</text>
          <text class="rating-label">喜欢</text>
        </button>
        <button class="ui-action rating-option" aria-label="一般" hover-class="interactive-pressed" data-rating="neutral" bindtap="onRatingTap">
          <text class="rating-icon">😐</text>
          <text class="rating-label">一般</text>
        </button>
        <button class="ui-action rating-option" aria-label="不喜欢" hover-class="interactive-pressed" data-rating="dislike" bindtap="onRatingTap">
          <text class="rating-icon">👎</text>
          <text class="rating-label">不喜欢</text>
        </button>
      </view>
      <button class="ui-action rating-skip" hover-class="interactive-pressed" bindtap="onRatingSkip">稍后再评</button>
    </view>
  </view>

  <!-- 条件面板（Story 14） -->
  <view wx:if="{{panelVisible}}" class="panel-mask" bindtap="closePanel">
    <view class="panel" catchtap="noop">
      <view class="panel-header">
        <text class="panel-title">调整推荐条件</text>
        <button class="ui-action panel-reset" hover-class="interactive-pressed" bindtap="onResetConditions">重置默认</button>
      </view>

      <view class="panel-section">
        <view class="panel-label">预算上限</view>
        <view class="option-row">
          <button
            wx:for="{{budgetOptions}}"
            wx:key="*this"
            class="ui-action option-chip {{conditions.budget === item ? 'option-active' : ''}}"
            aria-label="{{item === 0 ? '预算不限' : '预算上限' + item + '元'}}，{{conditions.budget === item ? '已选中' : '未选中'}}"
            hover-class="interactive-pressed"
            data-value="{{item}}"
            bindtap="onBudgetTap"
          >
            {{item === 0 ? '不限' : '¥' + item}}
          </button>
        </view>
      </view>

      <view class="panel-section">
        <view class="panel-label">可用时间</view>
        <view class="option-row">
          <button
            wx:for="{{timeOptions}}"
            wx:key="*this"
            class="ui-action option-chip {{conditions.maxTimeMinutes === item ? 'option-active' : ''}}"
            aria-label="可用时间{{item}}分钟，{{conditions.maxTimeMinutes === item ? '已选中' : '未选中'}}"
            hover-class="interactive-pressed"
            data-value="{{item}}"
            bindtap="onTimeTap"
          >
            {{item}} 分钟
          </button>
        </view>
      </view>

      <view class="panel-section">
        <view class="panel-label">口味偏好（可多选）</view>
        <view class="option-row">
          <button
            wx:for="{{tasteOptions}}"
            wx:key="*this"
            class="ui-action option-chip {{conditions.tastePreferences.indexOf(item) >= 0 ? 'option-active' : ''}}"
            aria-label="口味{{item}}，{{conditions.tastePreferences.indexOf(item) >= 0 ? '已选中' : '未选中'}}"
            hover-class="interactive-pressed"
            data-value="{{item}}"
            bindtap="onTasteTap"
          >
            {{item}}
          </button>
        </view>
      </view>

      <view class="panel-section">
        <view class="panel-label">最大距离：{{conditions.maxDistanceKm}} km</view>
        <slider aria-label="最大距离，当前 {{conditions.maxDistanceKm}} 公里" min="1" max="{{distanceMax}}" step="1" value="{{conditions.maxDistanceKm}}" bindchange="onDistanceChange" activeColor="#087f45" block-size="20" />
      </view>

      <button class="btn-primary panel-apply" bindtap="onApplyConditions">重新推荐</button>
    </view>
  </view>
</view>
