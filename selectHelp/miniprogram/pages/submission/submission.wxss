/* pages/submission/submission.wxss */
.card-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  margin-bottom: var(--spacing-md);
}

.sub-row {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  padding: var(--spacing-sm) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.sub-row:last-child {
  border-bottom: none;
}

.sub-name {
  flex: 1;
  min-width: 0;
  word-break: break-word;
}

.sub-time {
  color: var(--color-text-secondary);
  font-size: var(--font-size-xs);
}

.form-section {
  margin-bottom: var(--spacing-md);
}

.form-label {
  font-size: var(--font-size-md);
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-sm);
}

.form-input {
  background: #f5f5f5;
  border-radius: var(--radius-sm);
  padding: var(--spacing-sm) var(--spacing-md);
  font-size: var(--font-size-md);
}

.form-textarea {
  background: #f5f5f5;
  border-radius: var(--radius-sm);
  padding: var(--spacing-sm) var(--spacing-md);
  font-size: var(--font-size-md);
  width: 100%;
  min-height: 140rpx;
}

.option-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
}

.option-chip {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #f5f5f5;
  font-size: var(--font-size-sm);
  min-height: 72rpx;
  touch-action: manipulation;
}

.option-active {
  background: var(--color-primary);
  color: #ffffff;
}

.form-tip {
  margin-top: var(--spacing-sm);
  text-align: center;
  color: var(--color-text-secondary);
  font-size: var(--font-size-xs);
}

.form-error {
  margin-bottom: var(--spacing-md);
  padding: var(--spacing-sm) var(--spacing-md);
  border-radius: var(--radius-sm);
  background: #fdecee;
  color: var(--color-danger);
  font-size: var(--font-size-sm);
  word-break: break-word;
}
