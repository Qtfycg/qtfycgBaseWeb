<!-- pages/submission/submission.wxml — 菜谱投稿界面（Story 26 客户端） -->
<view class="page">
  <!-- 我的投稿 -->
  <view class="card" wx:if="{{submissions.length > 0}}">
    <view class="card-title">我的投稿</view>
    <view class="sub-row" wx:for="{{submissions}}" wx:key="id">
      <text class="sub-name">{{item.name}}</text>
      <text class="sub-time">{{item.timeText}}</text>
      <text class="tag {{item.statusClass}}">{{item.status}}</text>
    </view>
  </view>

  <!-- 投稿表单 -->
  <view class="card">
    <view class="card-title">提交菜谱</view>
    <view wx:if="{{formError}}" class="form-error status-live" aria-live="polite">{{formError}}</view>

    <view class="form-section">
      <view class="form-label">菜名 *</view>
      <input id="recipe-name" name="recipeName" aria-label="菜名，必填" class="form-input" placeholder="如：番茄炒蛋" value="{{form.name}}" bindinput="onNameInput" maxlength="30" />
    </view>

    <view class="form-section">
      <view class="form-label">简介</view>
      <input id="recipe-description" name="recipeDescription" aria-label="菜谱简介" class="form-input" placeholder="一句话介绍这道菜" value="{{form.description}}" bindinput="onDescInput" maxlength="60" />
    </view>

    <view class="form-section">
      <view class="form-label">适用餐次（可多选）</view>
      <view class="option-row">
        <button
          wx:for="{{periodOptions}}"
          wx:key="value"
          class="ui-action option-chip {{form.mealPeriods.indexOf(item.value) >= 0 ? 'option-active' : ''}}"
          aria-label="餐次{{item.label}}，{{form.mealPeriods.indexOf(item.value) >= 0 ? '已选中' : '未选中'}}"
          hover-class="interactive-pressed"
          data-value="{{item.value}}"
          bindtap="onPeriodTap"
        >{{item.label}}</button>
      </view>
    </view>

    <view class="form-section">
      <view class="form-label">口味（可多选）</view>
      <view class="option-row">
        <button
          wx:for="{{tasteOptions}}"
          wx:key="*this"
          class="ui-action option-chip {{form.tasteTags.indexOf(item) >= 0 ? 'option-active' : ''}}"
          aria-label="口味{{item}}，{{form.tasteTags.indexOf(item) >= 0 ? '已选中' : '未选中'}}"
          hover-class="interactive-pressed"
          data-value="{{item}}"
          bindtap="onTasteTap"
        >{{item}}</button>
      </view>
    </view>

    <view class="form-section">
      <view class="form-label">预计耗时（分钟）*</view>
      <input id="recipe-duration" name="recipeDuration" aria-label="预计耗时，单位为分钟，必填" class="form-input" type="number" placeholder="如：20" value="{{form.durationMinutes}}" bindinput="onDurationInput" />
    </view>

    <view class="form-section">
      <view class="form-label">食材清单 *（每行一个：名称 数量单位）</view>
      <textarea id="recipe-ingredients" name="recipeIngredients" aria-label="食材清单，必填" class="form-textarea" placeholder="番茄 2个&#10;鸡蛋 3个" value="{{form.ingredients}}" bindinput="onIngredientsInput" maxlength="500" />
    </view>

    <view class="form-section">
      <view class="form-label">烹饪步骤 *（每行一步）</view>
      <textarea id="recipe-steps" name="recipeSteps" aria-label="烹饪步骤，必填" class="form-textarea" placeholder="步骤1&#10;步骤2" value="{{form.steps}}" bindinput="onStepsInput" maxlength="500" />
    </view>

    <button class="btn-primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmit">提交审核</button>
    <view class="form-tip">提交失败会自动保存草稿，可稍后重试</view>
  </view>
</view>
