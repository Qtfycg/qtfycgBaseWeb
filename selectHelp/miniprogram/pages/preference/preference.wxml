<!-- pages/preference/preference.wxml — 默认偏好设置（Story 37） -->
<view class="page">
  <view class="card">
    <view class="label">默认预算上限</view>
    <view class="option-row">
      <button
        wx:for="{{budgetOptions}}"
        wx:key="*this"
        class="ui-action option-chip {{form.budget === item ? 'option-active' : ''}}"
        aria-label="{{item === 0 ? '预算不限' : '预算上限' + item + '元'}}，{{form.budget === item ? '已选中' : '未选中'}}"
        hover-class="interactive-pressed"
        data-value="{{item}}"
        bindtap="onBudgetTap"
      >{{item === 0 ? '不限' : '¥' + item}}</button>
    </view>
  </view>

  <view class="card">
    <view class="label">默认可用时间</view>
    <view class="option-row">
      <button
        wx:for="{{timeOptions}}"
        wx:key="*this"
        class="ui-action option-chip {{form.maxTimeMinutes === item ? 'option-active' : ''}}"
        aria-label="可用时间{{item}}分钟，{{form.maxTimeMinutes === item ? '已选中' : '未选中'}}"
        hover-class="interactive-pressed"
        data-value="{{item}}"
        bindtap="onTimeTap"
      >{{item}} 分钟</button>
    </view>
  </view>

  <view class="card">
    <view class="label">口味偏好（可多选）</view>
    <view class="option-row">
      <button
        wx:for="{{tasteOptions}}"
        wx:key="*this"
        class="ui-action option-chip {{form.tastePreferences.indexOf(item) >= 0 ? 'option-active' : ''}}"
        aria-label="口味{{item}}，{{form.tastePreferences.indexOf(item) >= 0 ? '已选中' : '未选中'}}"
        hover-class="interactive-pressed"
        data-value="{{item}}"
        bindtap="onTasteTap"
      >{{item}}</button>
    </view>
  </view>

  <view class="card">
    <view class="label">默认最大距离：{{form.maxDistanceKm}} km</view>
    <slider aria-label="默认最大距离，当前 {{form.maxDistanceKm}} 公里" min="1" max="{{distanceMax}}" step="1" value="{{form.maxDistanceKm}}" bindchange="onDistanceChange" />
  </view>

  <view class="tip">修改后自动保存，推荐首页和条件面板将使用这些默认值。</view>
</view>
