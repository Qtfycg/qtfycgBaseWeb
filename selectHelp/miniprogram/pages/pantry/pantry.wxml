<!-- pages/pantry/pantry.wxml — 家中食材管理（Story 17） -->
<view class="page">
  <!-- 空状态 -->
  <view wx:if="{{items.length === 0}}" class="empty-state">
    <text>还没有食材，添加第一个吧</text>
    <button class="btn-primary empty-btn" bindtap="onAddTap">添加食材</button>
  </view>

  <!-- 列表 -->
  <view wx:else>
    <view class="pantry-list">
      <view class="pantry-item" wx:for="{{items}}" wx:key="id">
        <view class="item-left">
          <text class="item-name">{{item.name}}</text>
          <text class="item-amount">{{item.amount}}{{item.unit}}</text>
        </view>
        <view class="item-right">
          <text class="item-expiry">{{item.expiryText}}</text>
          <text class="tag {{item.statusClass}}">{{item.statusText}}</text>
        </view>
        <view class="item-actions">
          <button class="ui-action ui-action-text action" aria-label="编辑{{item.name}}" hover-class="interactive-pressed" data-id="{{item.id}}" catchtap="onEditTap">编辑</button>
          <button class="ui-action ui-action-text action action-danger" aria-label="删除{{item.name}}" hover-class="interactive-pressed" data-id="{{item.id}}" catchtap="onDeleteTap">删除</button>
        </view>
      </view>
    </view>

    <!-- 添加按钮 -->
    <view class="add-bar">
      <button class="btn-primary" bindtap="onAddTap">添加食材</button>
    </view>
  </view>

  <!-- 新增/编辑弹层 -->
  <view wx:if="{{formVisible}}" class="form-mask" bindtap="onFormClose">
    <view class="form-panel" catchtap="noop">
      <view class="form-title">{{editingId ? '编辑食材' : '添加食材'}}</view>

      <!-- 标准食材选择 -->
      <view wx:if="{{!form.isCustom}}" class="form-section">
        <view class="form-label">选择食材</view>
        <view class="catalog-grid">
          <button
            wx:for="{{catalog}}"
            wx:key="ingredientId"
            class="ui-action catalog-chip {{form.ingredientId === item.ingredientId ? 'chip-active' : ''}}"
            aria-label="{{item.name}}，{{form.ingredientId === item.ingredientId ? '已选中' : '未选中'}}"
            hover-class="interactive-pressed"
            data-id="{{item.ingredientId}}"
            data-name="{{item.name}}"
            bindtap="onSelectIngredient"
          >{{item.name}}</button>
        </view>
        <button class="ui-action custom-link" hover-class="interactive-pressed" bindtap="onToggleCustom">没有想要的？自定义食材</button>
      </view>

      <!-- 自定义食材 -->
      <view wx:else class="form-section">
        <view class="form-label">食材名称</view>
        <input id="ingredient-name" name="ingredientName" aria-label="食材名称，必填" class="form-input" placeholder="输入食材名称" value="{{form.name}}" bindinput="onNameInput" />
        <button class="ui-action custom-link" hover-class="interactive-pressed" bindtap="onToggleCustom">从标准食材中选择</button>
      </view>

      <view class="form-section">
        <view class="form-label">数量</view>
        <input id="ingredient-amount" name="ingredientAmount" aria-label="食材数量，必填" class="form-input" type="digit" placeholder="如 2" value="{{form.amount}}" bindinput="onAmountInput" />
      </view>

      <view class="form-section">
        <view class="form-label">单位</view>
        <view class="unit-row">
          <button
            wx:for="{{unitOptions}}"
            wx:key="*this"
            class="ui-action unit-chip {{form.unit === item ? 'chip-active' : ''}}"
            aria-label="单位{{item}}，{{form.unit === item ? '已选中' : '未选中'}}"
            hover-class="interactive-pressed"
            data-value="{{item}}"
            bindtap="onUnitTap"
          >{{item}}</button>
        </view>
      </view>

      <view class="form-section">
        <view class="form-label">保质期</view>
        <picker mode="date" value="{{form.expiryDate}}" bindchange="onExpiryChange">
          <view class="form-input picker-value">{{form.expiryDate}}</view>
        </picker>
      </view>

      <view class="form-actions">
        <button class="btn-ghost" bindtap="onFormClose">取消</button>
        <button class="btn-primary" bindtap="onFormSubmit">保存</button>
      </view>
    </view>
  </view>
</view>
